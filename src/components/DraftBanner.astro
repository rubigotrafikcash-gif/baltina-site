---
import { draft } from '../content/site';

// Номер версии: в GitHub Actions — короткий хэш коммита, локально — время сборки
const sha = process.env.GITHUB_SHA?.slice(0, 7);
const version = sha ?? new Date().toISOString().slice(0, 16).replace('T', ' ');
---

<aside class="draft" aria-label="Статус страницы">
  <p class="container">
    {draft.banner}
    <span class="meta">Версия {version}. Анимация: <span data-motion-state>полная</span>.</span>
  </p>
</aside>

<script is:inline>
  (function () {
    var el = document.querySelector('[data-motion-state]');
    if (el && document.documentElement.classList.contains('motion-reduced')) {
      el.textContent = 'упрощённая (в системе включено «уменьшить движение»)';
    }
  })();
</script>

<style>
  .draft {
    background: var(--ink);
    color: #f6eef1;
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .draft p {
    padding-block: 0.55rem;
  }

  .meta {
    margin-left: 0.5em;
    opacity: 0.7;
  }
</style>
