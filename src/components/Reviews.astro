---
import { reviews } from '../content/site';
const slots = Array.from({ length: reviews.count });
---

<section id="reviews" class="section reviews" aria-labelledby="reviews-title">
  <div class="container">
    <h2 id="reviews-title" class="h2" data-reveal="title"><span>{reviews.title}</span></h2>
    <ul class="grid" data-reveal-group="150">
      {
        slots.map(() => (
          <li class="slot" data-reveal="scale">
            <span class="mark" aria-hidden="true">
              «
            </span>
            <p>{reviews.placeholder}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews {
    padding-top: 0;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding: 0;
    list-style: none;
  }

  .slot {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    border: 1.5px dashed #c9a9b4;
    color: var(--ink-soft);
  }

  .mark {
    font-family: var(--serif);
    font-size: 4rem;
    line-height: 0.6;
    color: var(--pink);
  }

  @media (min-width: 48em) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
