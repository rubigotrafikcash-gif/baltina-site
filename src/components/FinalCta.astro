---
import Button from './Button.astro';
import { cta, finalCta, links } from '../content/site';
---

<section class="final" aria-labelledby="final-title" data-final>
  <span class="bg" aria-hidden="true" data-final-bg></span>
  <div class="container inner">
    <h2 id="final-title" data-split="final">{finalCta.title}</h2>
    <p data-final-fade>{finalCta.text}</p>
    <div data-final-fade><Button href={links.telegramDm} variant="light">{cta.primary}</Button></div>
  </div>
</section>

<style>
  .final {
    position: relative;
    isolation: isolate;
    padding-block: calc(var(--section-y) * 1.4);
    background: var(--pink);
    color: var(--on-pink);
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--pink);
  }

  /* В режиме анимации розовый «разливается» кругом из центра */
  :global(.final--motion) {
    background: var(--paper);
  }

  :global(.final--motion) .bg {
    clip-path: circle(0% at 50% 55%);
  }

  .inner {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  h2 {
    font-size: clamp(2.5rem, 1.8rem + 3.6vw, 5rem);
    line-height: 1;
    max-width: 14em;
  }

  p {
    max-width: 32em;
    font-size: var(--fs-lead);
    margin-bottom: 0.75rem;
  }
</style>
