---
import Button from './Button.astro';
import { cta, links, service } from '../content/site';
---

<section id="service" class="section" aria-labelledby="service-title">
  <div class="container">
    <div class="head">
      <h2 id="service-title" class="h2" data-reveal="title"><span>{service.title}</span></h2>
      <p class="lead" data-reveal="up">{service.lead}</p>
    </div>

    <div class="cols" data-reveal-group="180">
      {
        [service.during, service.result].map((block) => (
          <div class="col" data-reveal="up">
            <h3>{block.title}</h3>
            <ul>
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="price" data-reveal="scale">
      <p>{service.price}</p>
      <Button href={links.telegramDm}>{cta.price}</Button>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1.5rem;
  }

  .cols {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
  }

  h3 {
    font-size: var(--fs-h3);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink);
  }

  ul {
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 1rem 0 1rem 1.6rem;
    border-bottom: 1px solid var(--line);
    max-width: 34em;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 1.65em;
    width: 0.7rem;
    height: 2px;
    background: var(--pink);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: var(--blush);
  }

  .price p {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.25;
    max-width: 24em;
  }

  @media (min-width: 60em) {
    .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }

    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }
  }
</style>
