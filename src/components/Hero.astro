---
import Button from './Button.astro';
import HeroCards from './HeroCards.astro';
import { cta, hero, links } from '../content/site';

---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <h1 id="hero-title" data-split="hero">{hero.title}</h1>
      <p class="lead" data-hero-fade>{hero.lead}</p>
      <div class="actions" data-hero-fade>
        <Button href={links.telegramDm}>{cta.primary}</Button>
        <Button href={hero.secondary.href} variant="text" external={false}>
          {hero.secondary.label}
        </Button>
      </div>
    </div>

    <div class="visual">
      <HeroCards />
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(3.5rem, 2rem + 5vw, 7rem);
  }

  .grid {
    display: grid;
    gap: clamp(2.75rem, 2rem + 4vw, 5rem);
    align-items: center;
  }

  h1 {
    font-size: var(--fs-h1);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 13em;
  }

  .lead {
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    max-width: 30em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
  }

  .visual {
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }

  @media (max-width: 29.99em) {
    .actions :global(.btn--solid) {
      width: 100%;
    }
  }

  @media (min-width: 60em) {
    .grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .visual {
      justify-self: end;
    }
  }
</style>
