---
import { steps } from '../content/site';
---

<section id="steps" class="section steps" aria-labelledby="steps-title" data-steps>
  <div class="pin" data-steps-pin>
    <div class="container head">
      <h2 id="steps-title" class="h2" data-split="lines"><span>{steps.title}</span></h2>
      <p class="note">{steps.duration}</p>
    </div>

    <div class="viewport">
      <ol class="track container" data-steps-track>
        {
          steps.items.map((step, i) => (
            <li class="step" data-step>
              <span class="num" aria-hidden="true" data-step-num>
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1rem;
  }

  .note {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .track {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-block: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
    align-items: baseline;
  }

  .num {
    grid-row: span 2;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(3.5rem, 3rem + 2vw, 5rem);
    line-height: 0.8;
    color: var(--pink);
    min-width: 0.6em;
  }

  h3 {
    font-size: var(--fs-h3);
  }

  .step p {
    grid-column: 2;
    margin-top: 0.5rem;
    color: var(--ink-soft);
    max-width: 24em;
  }

  @media (min-width: 48em) {
    .track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 4rem;
    }
  }

  @media (min-width: 64em) {
    .head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  /* --- Горизонтальная лента шагов (ставит скрипт на широких экранах) --- */
  :global(.steps--motion) {
    padding-block: 0;
  }

  :global(.steps--motion) .pin {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: calc(var(--header-h) + 2rem) 3rem;
    overflow: hidden;
  }

  :global(.steps--motion) .track {
    display: flex;
    gap: clamp(2rem, 4vw, 5rem);
    width: max-content;
    max-width: none;
    margin-top: clamp(3rem, 6vh, 5rem);
    padding-right: 30vw;
  }

  :global(.steps--motion) .step {
    width: clamp(18rem, 30vw, 27rem);
    grid-template-columns: 1fr;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  :global(.steps--motion) .num {
    grid-row: auto;
    font-size: clamp(7rem, 12vw, 12rem);
    line-height: 0.85;
    margin-bottom: 1.5rem;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--pink);
  }

  :global(.steps--motion) .step p {
    grid-column: 1;
  }
</style>
